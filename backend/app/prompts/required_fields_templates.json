{
  "_description": "Template-based requests for required fields (no LLM needed)",
  "_usage": "When missing a simple field with no ambiguity, use these templates instead of LLM",
  "_version": "4.0 - System-style labels (YC-aligned)",

  "destinations": {
    "questions": [
      "Destination:",
      "Destination:",
      "Destination:",
      "Destination:",
      "Destination:",
      "Destination:"
    ],
    "questions_by_domain": {
      "hotels": [
        "Hotel destination:",
        "Hotel location:",
        "Hotel destination:"
      ],
      "flights": [
        "Flight destination:",
        "Destination:",
        "Destination:"
      ],
      "activities": [
        "Activity location:",
        "Destination:",
        "Destination:"
      ],
      "transport": [
        "Transport destination:",
        "Destination:",
        "Destination:"
      ]
    },
    "suggestions": {
      "default": ["Paris", "Tokyo", "Bali"],
      "hiking": ["Swiss Alps", "Patagonia", "Nepal"],
      "skiing": ["Chamonix", "Whistler", "Niseko"],
      "diving": ["Maldives", "Great Barrier Reef", "Red Sea"],
      "cycling": ["Amsterdam", "Copenhagen", "Tuscany"],
      "boating": ["Greek Islands", "Croatia", "Caribbean"]
    }
  },

  "destinations_clarify": {
    "_description": "V16: Used when destination extraction fails or is ambiguous",
    "questions": {
      "ambiguous_place": [
        "Multiple matches for \"{user_input}\". Specify:",
        "\"{user_input}\" is ambiguous. Which one?"
      ],
      "unknown_place": [
        "\"{user_input}\" not recognized. Try again:",
        "Unknown destination: \"{user_input}\". Rephrase:"
      ],
      "typo_detected": [
        "Did you mean \"{suggestion}\"?",
        "Assuming \"{suggestion}\"?"
      ],
      "low_confidence": [
        "Confirm destination: \"{extracted_value}\"?",
        "Destination: \"{extracted_value}\"?"
      ],
      "multiple_destinations": [
        "Found: {destinations_list}. Multi-city trip?",
        "{destinations_list} - visit all?"
      ]
    },
    "suggestions": {
      "ambiguous_place": ["Show options", "Retype"],
      "unknown_place": ["Try again", "Popular destinations"],
      "typo_detected": ["Yes", "No, retype"],
      "low_confidence": ["Yes", "No"],
      "multiple_destinations": ["All together", "First only", "Clarify"]
    }
  },

  "origin": {
    "questions": [
      "Origin city:",
      "Departure city:",
      "Origin:",
      "Departing from:",
      "Origin city:",
      "Origin:"
    ],
    "suggestions": {
      "default": ["New York", "London", "Dubai"]
    }
  },

  "origin_clarify": {
    "_description": "V16: Used when origin extraction fails or is ambiguous",
    "questions": {
      "ambiguous_place": [
        "Multiple cities: \"{user_input}\". Specify:",
        "\"{user_input}\" ambiguous. Which one?"
      ],
      "unknown_place": [
        "\"{user_input}\" not found. Try again:",
        "Unknown origin: \"{user_input}\". Rephrase:"
      ]
    },
    "suggestions": {
      "default": ["Try again", "Nearby airports"]
    }
  },

  "dates": {
    "questions": [
      "Travel dates:",
      "Dates:",
      "Travel dates:",
      "Dates:",
      "Travel dates:",
      "Dates:"
    ],
    "suggestions": {
      "default": ["Next weekend", "In March", "Dec 15-22"],
      "hiking": ["Next weekend", "Spring", "Fall"],
      "skiing": ["Powder season", "February", "Winter"],
      "diving": ["Next weekend", "Summer", "Best visibility"],
      "cycling": ["Next weekend", "Spring", "Fall"],
      "boating": ["Next weekend", "Summer", "Sailing season"]
    }
  },

  "dates_clarify": {
    "_description": "Used when date range is ambiguous (straddles today or year unclear)",
    "questions": [
      "{date_range} - which year?",
      "{date_range}: {current_year} or {next_year}?",
      "Confirm: {date_range} in {current_year} or {next_year}?"
    ],
    "suggestions": {
      "default": ["{month} {current_year}", "{month} {next_year}"],
      "explicit_year": ["{current_year}", "{next_year}"]
    }
  },

  "travelers": {
    "questions": [
      "Travelers:",
      "Number of travelers:",
      "Travelers:",
      "Solo or group?",
      "Travelers:",
      "Travelers:"
    ],
    "suggestions": {
      "default": ["Solo", "2 adults", "Family of 4"],
      "hiking": ["Solo", "2 hikers", "Small group"],
      "skiing": ["Solo", "2 skiers", "Family"],
      "diving": ["Solo", "2 divers", "Small group"],
      "cycling": ["Solo", "2 cyclists", "Small group"],
      "boating": ["Solo", "Couple", "Group"]
    }
  },

  "budget": {
    "questions": [
      "Budget:",
      "Budget:",
      "Budget:",
      "Budget:",
      "Budget:",
      "Budget:"
    ],
    "suggestions": {
      "default": ["$2,000", "$5,000", "$10,000"],
      "hiking": ["$1,500", "$3,000", "$5,000"],
      "skiing": ["$2,000", "$4,000", "$8,000"],
      "diving": ["$2,000", "$5,000", "$10,000"],
      "cycling": ["$1,500", "$3,000", "$6,000"],
      "boating": ["$3,000", "$6,000", "$12,000"]
    }
  }
}
