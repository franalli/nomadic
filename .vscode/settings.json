{
  "editor.formatOnSave": true,

  // Prettier for JS/TS (frontend)
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  // Use Black for Python formatting
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter"
  },

  // Ensure the old formatter pipeline is off
  "python.formatting.provider": "none",

  // Ruff extension handles linting & code
  "ruff.enable": true,
  "ruff.path": ["ruff"],   // Use Ruff from the environment
  "ruff.organizeImports": false, // Ruff already fixes imports via pre-commit; keep off if you prefer
  "ruff.importStrategy": "fromEnvironment",
  "editor.codeActionsOnSave": {
    "source.fixAll.ruff": "explicit"  // Run Ruff quick-fixes explicitly on save if you want
  },

  // Tailwind support
  "tailwindCSS.includeLanguages": {
    "typescript": "html",
    "typescriptreact": "html"
  },

  // Show lint markers (Ruff, ESLint)
  "python.linting.enabled": false,

  // Optional: Auto organize imports for TS/TSX
  "typescript.preferences.importModuleSpecifier": "relative",
  "typescript.updateImportsOnFileMove.enabled": "always",

  // PERFORMANCE: Process isolation for Claude extension
  "extensions.experimental.affinity": {
    "anthropic.claude-code": 1
  },

  // PERFORMANCE: Exclude heavy folders from VS Code indexing
  "files.exclude": {
    "**/.git": true,
    "**/.next": true,
    "**/__pycache__": true,
    "**/node_modules": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "**/.next": true
  },

  // PERFORMANCE: Reduce file watcher memory usage
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/.next/**": true,
    "**/__pycache__/**": true,
    "**/db-data/**": true,
    "**/.venv/**": true
  },

  // PERFORMANCE: Limit TypeScript server memory
  "typescript.tsserver.maxTsServerMemory": 2048
}
