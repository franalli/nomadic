{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Docker: Compose DB",
            "type": "shell",
            "command": "source ${workspaceFolder}/backend/.venv/bin/activate && pip install -r requirements.txt && docker compose up db --build -d && alembic upgrade head",
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "runOptions": {
                "runOn": "folderOpen"
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Backend: Uvicorn",
            "type": "shell",
            "command": "source ${workspaceFolder}/backend/.venv/bin/activate && python start.py",
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "runOptions": {
                "runOn": "folderOpen"
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Frontend: Next Dev",
            "type": "shell",
            "command": "npm run dev",
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "runOptions": {
                "runOn": "folderOpen"
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Start All",
            "dependsOn": [
                "Docker: Compose DB",
                "Backend: Uvicorn",
                "Frontend: Next Dev"
            ],
            "problemMatcher": []
        },
        {
            "label": "Claude: Cleanup History",
            "type": "shell",
            "command": "bash ${workspaceFolder}/scripts/cleanup-claude-history.sh",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Copy Key Backend Files",
            "type": "shell",
            "command": "bash ${workspaceFolder}/scripts/copy-key-files.sh",
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}
